{
  "name": "folio-internal-tools",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "overrides": {
    "next": { "postcss": "$postcss" },
    "@prisma/config": { "deepmerge-ts": "8.0.2" }
  },
  "scripts": {
    "setup": "node scripts/local-env.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.33",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.1.1"
  }
}
